# ============================================================================
# DATABASE CONFIGURATION
# 1. Rename this file to "database.env"
# 2. Choose a strong password below (letters and digits only is the simplest)
#
# These values are used by BOTH containers: the MariaDB container creates the
# database and the user with them, and the web application connects with them.
# They are only read when the database volume is created for the first time:
# to change the password later, change it in MariaDB too (see README.md).
# ============================================================================

MARIADB_DATABASE=projecttracker
MARIADB_USER=projecttracker
MARIADB_PASSWORD=change_this_database_password
