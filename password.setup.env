# ============================================================================
# EXAMPLE CONFIGURATION FILE
# 1. Rename this file to "password.env"
# 2. Setup the password below
# ============================================================================

# Password used to access the panel
PASSWORD=your_password

# ============================================================================
# Secret key used to protect the login sessions stored in the database.
# Change this value before deploying to production.
# Use a long random string (32+ characters recommended), e.g. the output of:
#     openssl rand -hex 32
# Never share this value publicly. Changing it logs everybody out.
# ============================================================================

SESSION_SECRET=put_a_long_random_string_here_min_32_chars

# ============================================================================
# Optional settings
# ============================================================================

# A session ends after this many hours without activity (default: 8)
#SESSION_LIFETIME_HOURS=8

# Time zone used when the server has to set a date itself (default: Europe/Paris)
#APP_TIMEZONE=Europe/Paris

# "Secure" flag of the session cookie: auto (default: set when the site is
# reached through HTTPS, e.g. behind Caddy), true or false
#SESSION_COOKIE_SECURE=auto
